# docker/mlflow/.env にコピーして使う（.env は git に入れない）#47
# このマシンの LAN の IP（hostname -I で確認）。192.0.2.10 は説明用のダミー（RFC 5737）なので必ず書き換える
MLFLOW_LAN_ADDRESS=192.0.2.10
# MLflow が受け付ける Host ヘッダー（先頭のカンマが必要）
MLFLOW_EXTRA_ALLOWED_HOSTS=,192.0.2.10:*
# 画面（ブラウザ）からの要求の Origin。これが無いとグラフなどが「Failed to load chart data」になる（先頭のカンマが必要）
MLFLOW_EXTRA_CORS_ORIGINS=,http://192.0.2.10:5000
